#!/bin/bash
# Manage the iGPU (dock) display outputs in one of two directions:
#
#   dGPU/keeper display present -> force every connector of IGNORED_GPUS off
#   no keeper display           -> clear any force and re-probe them instead
#
# Policy
# ------
# The ignored GPU is the APU, whose only display use is the HP dock's HDMI
# path (a second link to the same panel). While the dGPU drives the panel,
# the dock output must never be driven: it produces a phantom second monitor
# and its link training interferes with cold-start detection on the direct
# link.
#
# If no non-ignored GPU has a connected output (dGPU removed, dead, no
# monitor on it, or the direct cable unplugged) the APU outputs are *enabled*
# instead — that is the rescue console. This also undoes the name-based
# `video=DP-4:d/DP-5:d` cmdline block, so a wrong name can never leave the
# machine with no output at all.
#
# Kill switches:
#   - `drm_ignore_dock=0` on the kernel cmdline (editable from the GRUB menu)
#     -> take the enable branch unconditionally;
#   - live session: echo detect | sudo tee /sys/class/drm/cardN-XXX/status
#     or `sudo systemctl disable --now drm-ignore-dock`.
#
# Why match by PCI id instead of connector name
# ---------------------------------------------
# DRM connector ids are not per-GPU: drm_connector_init() takes them from a
# kernel-global per-type IDA (drm_connector_enum_list[type].ida) in creation
# order, so "DP-4" means "the 4th DP connector registered by any driver this
# boot". Probe order, per-GPU link counts, DC/BIOS changes and the physical
# port all renumber it -- exactly what turned DP-5/DP-3 into DP-4/DP-2
# between kernel 7.2.3 and 7.2.6. cardN is a second, independent axis.
#
# Note: this runs after the kernel's first KMS probe, so the disable branch
# cannot prevent boot-time link-training interference by itself -- that is
# what the video= cmdline block and the pre-greeter EDID wait are for.
set -u

IGNORED_GPUS=("0x1002:0x13c0")   # Granite Ridge iGPU = USB-C dock display link
SYSFS=${DRM_SYSFS:-/sys/class/drm}                # override point for testing
KEEPER_WAIT=${DRM_KEEPER_WAIT:-5}                 # seconds to wait for a keeper

log() { echo "drm-ignore-dock: $*"; }

is_ignored() {
    local id=$1 want
    for want in "${IGNORED_GPUS[@]}"; do
        [ "$id" = "$want" ] && return 0
    done
    return 1
}

# <connector .../status path> -> "0x1002:0x13c0" of the card that owns it
card_id_of() {
    local path=${1%/status}
    local card=${path##*/}
    card=${card%%-*}
    [ -e "$SYSFS/$card/device/vendor" ] || return 1
    echo "$(cat "$SYSFS/$card/device/vendor" 2>/dev/null):$(cat "$SYSFS/$card/device/device" 2>/dev/null)"
}

conn_name() {
    local path=${1%/status}
    echo "${path##*/}"
}

# any connector on a non-ignored GPU that reports connected?
keeper_connected() {
    local c id
    for c in "$SYSFS"/card[0-9]*-*/status; do
        [ -e "$c" ] || continue
        case "$c" in *Writeback*) continue ;; esac
        id=$(card_id_of "$c") || continue
        is_ignored "$id" && continue
        [ "$(cat "$c" 2>/dev/null)" = connected ] && return 0
    done
    return 1
}

# one line per boot: connector-name -> status, so a future renumbering is
# visible in the journal
log_map() {
    local line="" c
    for c in "$SYSFS"/card[0-9]*-*/status; do
        [ -e "$c" ] || continue
        case "$c" in *Writeback*) continue ;; esac
        line+="$(conn_name "$c")=$(cat "$c" 2>/dev/null) "
    done
    log "map: ${line% }"
}

disable_ignored() {
    local c id found=0
    for c in "$SYSFS"/card[0-9]*-*/status; do
        [ -e "$c" ] || continue
        case "$c" in *Writeback*) continue ;; esac
        id=$(card_id_of "$c") || continue
        is_ignored "$id" || continue
        found=1
        if echo off > "$c" 2>/dev/null; then
            log "forced off $(conn_name "$c") ($id)"
        else
            log "WARNING: could not force off $(conn_name "$c") ($id)"
        fi
    done
    [ "$found" -eq 1 ] || log "WARNING: no GPU matching ${IGNORED_GPUS[*]} - nothing to ignore"
}

enable_ignored() {
    local c id
    for c in "$SYSFS"/card[0-9]*-*/status; do
        [ -e "$c" ] || continue
        case "$c" in *Writeback*) continue ;; esac
        id=$(card_id_of "$c") || continue
        is_ignored "$id" || continue
        # "detect" clears DRM_FORCE_OFF, so this also undoes video=...:d
        if echo detect > "$c" 2>/dev/null; then
            log "re-enabled $(conn_name "$c") ($id)"
        else
            log "WARNING: could not re-enable $(conn_name "$c") ($id)"
        fi
    done
}

# ---- explicit override -----------------------------------------------
if grep -qw 'drm_ignore_dock=0' /proc/cmdline 2>/dev/null; then
    log "drm_ignore_dock=0 on cmdline: enabling ${IGNORED_GPUS[*]}"
    enable_ignored
    log_map
    exit 0
fi

# ---- wait for the keeper display (dGPU panel) to come up -------------
deadline=$((SECONDS + KEEPER_WAIT))
until keeper_connected; do
    if [ "$SECONDS" -ge "$deadline" ]; then
        log "no display on a non-ignored GPU: leaving ${IGNORED_GPUS[*]} usable (fallback console)"
        enable_ignored
        log_map
        exit 0
    fi
    sleep 0.25
done

# ---- normal case: panel is on the dGPU, silence the dock path --------
disable_ignored
log_map
exit 0
