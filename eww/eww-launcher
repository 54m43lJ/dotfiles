#!/bin/bash
# eww-launcher — starts eww daemon and opens one status bar per monitor

if pidof eww >/dev/null; then
    eww reload
    eww close-all
else
    eww daemon
    sleep 0.5
fi

hyprctl monitors -j | jq -r '.[].name' | while read -r monitor; do
    eww open w_bar --id "bar_${monitor}" --arg "monitor=$monitor"
    echo "Opened bar → $monitor"
done

eww open w_control_center
echo "Opened control center"
