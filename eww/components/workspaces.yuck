(deflisten workspaces :initial "[]" "bash ~/.config/eww/scripts/get-workspaces")

(defwidget workspaces [monitor]
  (eventbox :onscroll "bash ~/.config/eww/scripts/change-active-workspace {} ${monitor}" :class "workspaces-widget"
    (box :space-evenly true
      (label :text "${workspaces}" :visible false)
      (for workspace in workspaces
        (box :visible "${workspace.monitor == monitor}"
          (eventbox :onclick "bash ~/.config/eww/scripts/switch-workspace ${workspace.id} ${monitor}"
            :class "workspace-entry ${workspace.windows > 0 ? "occupied" : "empty"} ${workspace.active ? "current" : ""}"
            (label :text "${workspace.id == "10" ? "0" : workspace.id}")
          )
        )
      )
    )
  )
)
